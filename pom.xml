  <profiles>
    <profile>
      <id>jdk8-to20</id>
      <activation>
        <jdk>[1.8,21)</jdk>
      </activation>
      <properties>
        <!-- Default JVM arguments; the parent supplies argLine on Java 21+. -->
        <argLine></argLine>
      </properties>
    </profile>
    <profile>
      <id>docker-it</id>
      <build>
        <plugins>
          <plugin>
            <groupId>io.fabric8</groupId>
            <artifactId>docker-maven-plugin</artifactId>
            <version>0.49.0</version>
            <configuration>
              <skip>${skipITs}</skip>
              <containerNamePattern>dbcp-%a-%t</containerNamePattern>
              <removeVolumes>true</removeVolumes>
              <images>
                <image>
                  <alias>postgresql</alias>
                  <name>${dbcp.docker.postgresql.image}</name>
                  <run>
                    <env>
                      <POSTGRES_DB>dbcp</POSTGRES_DB>
                      <POSTGRES_USER>dbcp</POSTGRES_USER>
                      <POSTGRES_PASSWORD>dbcp-test</POSTGRES_PASSWORD>
                    </env>
                    <cmd>postgres -c max_prepared_transactions=100</cmd>
                    <ports>
                      <port>${dbcp.docker.bindAddress}:dbcp.postgresql.port:5432</port>
                    </ports>
                    <labels>
                      <org.apache.commons.dbcp.testRun>${dbcp.docker.runId}</org.apache.commons.dbcp.testRun>
                    </labels>
                    <wait>
                      <log>(?s)PostgreSQL init process complete; ready for start up.*database system is ready to accept connections</log>
                      <time>${dbcp.docker.waitMillis}</time>
                    </wait>
                    <log>
                      <enabled>true</enabled>
                    </log>
                  </run>
                </image>
                <image>
                  <alias>mysql</alias>
                  <name>${dbcp.docker.mysql.image}</name>
                  <run>
                    <env>
                      <MYSQL_DATABASE>dbcp</MYSQL_DATABASE>
                      <MYSQL_USER>dbcp</MYSQL_USER>
                      <MYSQL_PASSWORD>dbcp-test</MYSQL_PASSWORD>
                      <MYSQL_ROOT_PASSWORD>dbcp-root-test</MYSQL_ROOT_PASSWORD>
                    </env>
                    <ports>
                      <port>${dbcp.docker.bindAddress}:dbcp.mysql.port:3306</port>
                    </ports>
                    <labels>
                      <org.apache.commons.dbcp.testRun>${dbcp.docker.runId}</org.apache.commons.dbcp.testRun>
                    </labels>
                    <wait>
                      <log>ready for connections.*port: 3306</log>
                      <time>${dbcp.docker.waitMillis}</time>
                    </wait>
                    <log>
                      <enabled>true</enabled>
                    </log>
                  </run>
                </image>
                <image>
                  <alias>mariadb</alias>
                  <name>${dbcp.docker.mariadb.image}</name>
                  <run>
                    <env>
                      <MARIADB_DATABASE>dbcp</MARIADB_DATABASE>
                      <MARIADB_USER>dbcp</MARIADB_USER>
                      <MARIADB_PASSWORD>dbcp-test</MARIADB_PASSWORD>
                      <MARIADB_ROOT_PASSWORD>dbcp-root-test</MARIADB_ROOT_PASSWORD>
                    </env>
                    <ports>
                      <port>${dbcp.docker.bindAddress}:dbcp.mariadb.port:3306</port>
                    </ports>
                    <labels>
                      <org.apache.commons.dbcp.testRun>${dbcp.docker.runId}</org.apache.commons.dbcp.testRun>
                    </labels>
                    <wait>
                      <log>(?s)ready for connections.*port: 3306</log>
                      <time>${dbcp.docker.waitMillis}</time>
                    </wait>
                    <log>
                      <enabled>true</enabled>
                    </log>
                  </run>
                </image>
                <image>
                  <alias>oracle</alias>
                  <name>${dbcp.docker.oracle.image}</name>
                  <run>
                    <platform>linux/amd64</platform>
                    <shmSize>1073741824</shmSize>
                    <env>
                      <ORACLE_PASSWORD>${dbcp.docker.oracle.password}</ORACLE_PASSWORD>
                      <APP_USER>dbcp</APP_USER>
                      <APP_USER_PASSWORD>dbcp-test</APP_USER_PASSWORD>
                    </env>
                    <ports>
                      <port>${dbcp.docker.bindAddress}:dbcp.oracle.port:1521</port>
                    </ports>
                    <labels>
                      <org.apache.commons.dbcp.testRun>${dbcp.docker.runId}</org.apache.commons.dbcp.testRun>
                    </labels>
                    <wait>
                      <log>DATABASE IS READY TO USE!</log>
                      <time>${dbcp.docker.oracle.waitMillis}</time>
                    </wait>
                    <log>
                      <enabled>true</enabled>
                    </log>
                  </run>
                </image>
                <image>
                  <alias>sqlserver</alias>
                  <name>${dbcp.docker.sqlserver.image}</name>
                  <run>
                    <platform>linux/amd64</platform>
                    <env>
                      <ACCEPT_EULA>Y</ACCEPT_EULA>
                      <MSSQL_PID>Developer</MSSQL_PID>
                      <MSSQL_SA_PASSWORD>${dbcp.docker.sqlserver.password}</MSSQL_SA_PASSWORD>
                      <MSSQL_MEMORY_LIMIT_MB>2048</MSSQL_MEMORY_LIMIT_MB>
                      <MSSQL_RPC_PORT>13500</MSSQL_RPC_PORT>
                      <MSSQL_DTC_TCP_PORT>51000</MSSQL_DTC_TCP_PORT>
                    </env>
                    <ports>
                      <port>${dbcp.docker.bindAddress}:dbcp.sqlserver.port:1433</port>
                    </ports>
                    <labels>
                      <org.apache.commons.dbcp.testRun>${dbcp.docker.runId}</org.apache.commons.dbcp.testRun>
                    </labels>
                    <wait>
                      <log>SQL Server is now ready for client connections</log>
                      <time>${dbcp.docker.waitMillis}</time>
                    </wait>
                    <log>
                      <enabled>true</enabled>
                    </log>
                  </run>
                </image>
              </images>
            </configuration>
            <executions>
              <execution>
                <id>start-test-databases</id>
                <phase>pre-integration-test</phase>
                <goals>
                  <goal>start</goal>
                </goals>
              </execution>
              <execution>
                <id>stop-test-databases</id>
                <phase>post-integration-test</phase>
                <goals>
                  <goal>stop</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <jvm>${commons.surefire.java}</jvm>
              <argLine>@{dbcp.jacoco.argLine} ${argLine} ${surefire.argline}</argLine>
              <failIfNoTests>true</failIfNoTests>
              <systemPropertyVariables>
                <dbcp.test.databases>${dbcp.test.databases}</dbcp.test.databases>
